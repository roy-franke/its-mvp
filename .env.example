# LLM-Provider: anthropic | openai | ollama | mock
LLM_PROVIDER=mock

# Anthropic (Cloud)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI oder OpenAI-kompatible API (Cloud)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (lokal, z.B. auf RIB-AI-01)
OLLAMA_BASE_URL=http://localhost:11434
# Denkmodus von Reasoning-Modellen: false = schnell (Standard),
# true = gruendlicher, aber deutlich langsamer
OLLAMA_THINK=false
# Temperatur der Antwortbewertung (0 = reproduzierbar, Standard)
ITS_BEWERTUNG_TEMPERATUR=0
# Internetrecherche als dritte Wissensstufe (N-03), standardmaessig aus.
# Braucht einen SearXNG-Dienst mit JSON-Ausgabe (search.formats: json).
ITS_WEB_SEARCH=false
ITS_SEARXNG_URL=
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=16384
# Obergrenze fuer die Antwortlaenge in Token. Der Tutor braucht selten mehr
# als 500; die Grenze schuetzt nur vor Ausreissern.
OLLAMA_NUM_PREDICT=1024
# Gültiges JSON erzwingen, wo der Tutor JSON erwartet (verhindert Fallbacks)
OLLAMA_FORMAT_JSON=true
OLLAMA_MODEL=llama3.1:8b

# Anzahl Lernschritte pro Durchlauf
ITS_TOTAL_STEPS=8

# Optional: Pfad zur SQLite-Datenbank (Standard: its.db im Projektordner)
# ITS_DB_PATH=/pfad/zu/its.db

# --- Zugangsschutz (für Klassentest / Veröffentlichung) ---
# Passwort für die Lehrpersonen-Sicht (/teacher). Leer = kein Login (nur lokal!)
TEACHER_PASSWORD=
# Zugangscode, den Lernende beim Start eingeben müssen. Leer = kein Code
CLASS_CODE=

# --- Anmeldung über Header eines Proxys (optional, siehe docs/DEPLOYMENT-CLOUDFLARE.md) ---
# Nur einschalten, wenn der Proxy diese Header selbst setzt und fremde entfernt!
ITS_TRUST_PROXY_HEADERS=false
ITS_USER_HEADER=X-Forwarded-User
ITS_ROLES_HEADER=X-User-Roles
ITS_TEACHER_ROLE=teacher
# Domain für den HTTPS-Betrieb mit Docker/Caddy (siehe docs/DEPLOYMENT.md)
ITS_DOMAIN=localhost
